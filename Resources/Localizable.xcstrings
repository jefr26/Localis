    "prompt.condense": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Condensa estas notas en menos de 100 palabras, conservando lo relevante para esta tarea: %@\n---\n%@\n---"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Condense these notes into fewer than 100 words, keeping what's relevant to this task: %@\n---\n%@\n---"
          }
        }
      }
    },
    "prompt.defaultTask": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz un resumen claro y breve del contenido."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Write a clear, brief summary of the content."
          }
        }
      }
    },
    "prompt.file": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Archivo: «%@»\n---\n%@\n---\nTarea: %@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "File: “%@”\n---\n%@\n---\nTask: %@"
          }
        }
      }
    },
    "prompt.final": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "A continuación hay notas de un archivo llamado «%@». %@\n\n%@\n\nCon base en esas notas, cumple esta tarea: %@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Below are notes from a file named “%@”. %@\n\n%@\n\nBased on these notes, complete this task: %@"
          }
        }
      }
    },
    "prompt.fragment": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "[Fragmento %lld de %lld]\n%@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "[Passage %lld of %lld]\n%@"
          }
        }
      }
    },
    "prompt.instructions": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Eres Localis, un asistente en el Mac del usuario. Responde en el idioma en que está escrita la petición del usuario, de forma clara y breve."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You are Localis, an assistant on the user's Mac. Reply in the language the user's request is written in, clearly and concisely."
          }
        }
      }
    },
    "prompt.notePart": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Parte %lld: %@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Part %lld: %@"
          }
        }
      }
    },
    "prompt.notes": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Parte %lld de %lld del archivo «%@». Extrae solo la información relevante para esta tarea: %@\nResponde con notas muy breves (máximo 80 palabras).\n---\n%@\n---"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Part %lld of %lld of the file “%@”. Extract only the information relevant to this task: %@\nReply with very short notes (80 words max).\n---\n%@\n---"
          }
        }
      }
    },
    "prompt.origin.full": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El archivo se leyó completo en %lld partes."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The whole file was read in %lld parts."
          }
        }
      }
    },
    "prompt.origin.sampled": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El archivo es muy largo: solo se leyeron %lld de %lld partes, repartidas a lo largo del archivo (una muestra)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The file is very long: only %lld of %lld parts were read, spread across the file (a sample)."
          }
        }
      }
    },
    "prompt.retrieval": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Fragmentos del archivo «%@» más relacionados con la pregunta (no es el archivo completo):\n\n%@\n\n---\nPregunta: %@\nResponde usando solo la información de los fragmentos. Si la respuesta no está en ellos, dilo claramente."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Passages from the file “%@” most related to the question (not the whole file):\n\n%@\n\n---\nQuestion: %@\nAnswer using only the information in the passages. If the answer isn't in them, say so clearly."
          }
        }
      }
    },
    "prompt.skippedPart": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "(parte omitida por el filtro de contenido del modelo)"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "(part skipped by the model's content filter)"
          }
        }
      }
    },
